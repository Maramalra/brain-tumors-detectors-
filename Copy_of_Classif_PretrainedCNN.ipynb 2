      "source": [
        "### Implement Targeted Data Augmentation\n",
        "\n",
        "As requested, we will apply different levels of data augmentation. 'Glioma' and 'meningioma' classes will receive more aggressive augmentation to help the model learn more robust features and reduce confusion between them. Other classes will receive a standard set of augmentations."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "abf77f44",
        "outputId": "354604e4-e327-4311-a552-04f33ba433ef"
      },
      "source": [
        "# Define augmentation layers\n",
        "# Light augmentation for general classes\n",
        "light_augmenter = keras.Sequential([\n",
        "    layers.RandomFlip(\"horizontal_and_vertical\"),\n",
        "    layers.RandomRotation(0.1),\n",
        "])\n",
        "\n",
        "# Heavier augmentation specifically for 'glioma' and 'meningioma'\n",
        "heavy_augmenter = keras.Sequential([\n",
        "    layers.RandomFlip(\"horizontal_and_vertical\"),\n",
        "    layers.RandomRotation(0.2),\n",
        "    layers.RandomZoom(height_factor=0.2, width_factor=0.2),\n",
        "    layers.RandomContrast(factor=0.2),\n",
        "])\n",
        "\n",
        "# Get indices for 'glioma' and 'meningioma' to apply targeted augmentation\n",
        "glioma_idx = class_names.index('glioma')\n",
        "meningioma_idx = class_names.index('meningioma')\n",
        "\n",
        "def apply_targeted_augmentation(image, label):\n",
        "    # Convert label to integer if it's a tensor\n",
        "    label_int = tf.cast(label, tf.int32)\n",
        "\n",
        "    # Apply heavy augmentation for glioma and meningioma\n",
        "    if tf.equal(label_int, glioma_idx) or tf.equal(label_int, meningioma_idx):\n",
        "        augmented_image = heavy_augmenter(image, training=True)\n",
        "    else:\n",
        "        augmented_image = light_augmenter(image, training=True)\n",
        "    return augmented_image, label\n",
        "\n",
        "# Apply the targeted augmentation to the training dataset\n",
        "# Ensure to unbatch first, apply augmentation, then batch again to avoid augmenting entire batches as one image\n",
        "train_ds_augmented = train_ds.unbatch().map(apply_targeted_augmentation, num_parallel_calls=AUTOTUNE).batch(batch_size).prefetch(AUTOTUNE)\n",
        "\n",
        "print(\"Targeted data augmentation pipeline created and applied to training dataset.\")"
