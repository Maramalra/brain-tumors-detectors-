        "## Make Predictions on Sample Images\n",
        "\n",
        "Let's see our trained model make predictions on a few images from the test dataset. We'll visualize the image, its true label, and the model's predicted label with its confidence."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 175
        },
        "id": "cd350f7f",
        "outputId": "7c039fd0-9d6c-4dae-a7e0-f5ad1c3f052e"
      },
      "source": [
        "import random\n",
        "\n",
        "def plot_predictions(model, test_dataset, class_names, num_images=5):\n",
        "    # Collect all individual images and labels from the test dataset\n",
        "    # This allows for true random sampling across the entire dataset.\n",
        "    all_images = []\n",
        "    all_labels = []\n",
        "    for images_batch, labels_batch in test_dataset:\n",
        "        for img, lbl in zip(images_batch.numpy(), labels_batch.numpy()):\n",
        "            all_images.append(img)\n",
        "            all_labels.append(lbl)\n",
        "\n",
        "    # Ensure lists are numpy arrays for easier indexing\n",
        "    all_images = np.array(all_images)\n",
        "    all_labels = np.array(all_labels)\n",
        "\n",
        "    # Randomly select 'num_images' indices from the collected data\n",
        "    if len(all_images) < num_images:\n",
        "        print(f\"Warning: Not enough images in the dataset ({len(all_images)}) to display {num_images}. Displaying all available.\")\n",
        "        indices = list(range(len(all_images)))\n",
        "    else:\n",
        "        indices = random.sample(range(len(all_images)), num_images)\n",
        "\n",
        "    selected_images = all_images[indices]\n",
        "    selected_labels = all_labels[indices]\n",
        "\n",
        "    # Make predictions on the selected images\n",
        "    predictions = model.predict(selected_images)\n",
        "\n",
        "    plt.figure(figsize=(15, 10))\n",
        "    for i in range(len(selected_images)): # Iterate over selected images\n",
        "        ax = plt.subplot(1, num_images, i + 1)\n",
        "        plt.imshow(selected_images[i].astype(\"uint8\"))\n",
        "        true_label = class_names[selected_labels[i]]\n",
        "        predicted_label = class_names[np.argmax(predictions[i])]\n",
        "        confidence = np.max(predictions[i])\n",
        "\n",
        "        color = \"green\" if predicted_label == true_label else \"red\"\n",
        "\n",
        "        plt.title(f\"True: {true_label}\\nPred: {predicted_label} ({confidence:.2f})\", color=color)\n",
        "        plt.axis(\"off\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# Visualize predictions on 5 sample images from the test set\n",
        "plot_predictions(loaded_model, test_ds, class_names, num_images=5)"
      ],
