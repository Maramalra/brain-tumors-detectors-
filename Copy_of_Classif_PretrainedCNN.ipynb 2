      "source": [
        "# Configure the dataset for performance\n",
        "AUTOTUNE = tf.data.AUTOTUNE\n",
        "\n",
        "train_ds = train_ds.cache().shuffle(1000).prefetch(buffer_size=AUTOTUNE)\n",
        "val_ds = val_ds.cache().prefetch(buffer_size=AUTOTUNE)\n",
        "test_ds = test_ds.cache().prefetch(buffer_size=AUTOTUNE)\n",
        "\n",
        "# Preprocessing function for EfficientNet\n",
        "def preprocess_image(image, label):\n",
        "    # EfficientNet models expect pixel values in the range [0, 255].\n",
        "    # No explicit rescaling to [-1, 1] or [0, 1] is needed for the EfficientNet.tfkeras\n",
        "    # implementation as it handles this internally for its specific preprocessing layers.\n",
        "    # However, if you were using a different preprocessing, you might do:\n",
        "    # image = tf.cast(image, tf.float32) / 255.0 # If model expects [0,1]\n",
        "    return image, label\n",
        "\n",
        "train_ds = train_ds.map(preprocess_image)\n",
        "val_ds = val_ds.map(preprocess_image)\n",
        "test_ds = test_ds.map(preprocess_image)\n",
        "\n",
        "print(\"Datasets configured and preprocessed.\")"
