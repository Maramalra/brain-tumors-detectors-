lly there, not a guess\n","import os\n","for root, dirs, files in os.walk(DATASET_ROOT):\n","    if root.count(\"/\") <= str(DATASET_ROOT).count(\"/\") + 3:\n","        print(root, f\"({len(files)} files)\")"],"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Using Colab cache for faster access to the 'brisc2025' dataset.\n","Downloaded to: /kaggle/input/brisc2025\n","/kaggle/input/brisc2025 (0 files)\n","/kaggle/input/brisc2025/brisc2025 (5 files)\n","/kaggle/input/brisc2025/brisc2025/segmentation_task (0 files)\n","/kaggle/input/brisc2025/brisc2025/segmentation_task/test (0 files)\n","/kaggle/input/brisc2025/brisc2025/segmentation_task/train (0 files)\n","/kaggle/input/brisc2025/brisc2025/classification_task (0 files)\n","/kaggle/input/brisc2025/brisc2025/classification_task/test (0 files)\n","/kaggle/input/brisc2025/brisc2025/classification_task/train (0 files)\n"]}]},{"cell_type":"markdown","metadata":{"id":"5eb586f9"},"source":["### Define Data Paths\n","\n","Assuming the dataset is structured with `training` and `testing` folders, and each contains image and mask subfolders, we'll define the base paths. Please adjust `DATA_DIR` if your dataset is located elsewhere."]},{"cell_type":"code","metadata":{"id":"de258e18","executionInfo":{"status":"ok","timestamp":1788882297858,"user_tz":-180,"elapsed":2535,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"df1b549c-413c-41fb-a7ad-3b9f65ece207"},"source":["from pathlib import Path\n","\n","SEG_ROOT = Path(\"/kaggle/input/brisc2025/brisc2025/segmentation_task\")\n","\n","# Show what is actually inside train/ and test/ before assuming names\n","for split in sorted(SEG_ROOT.iterdir()):\n","    print(split.name + \"/\")\n","    for sub in sorted(split.iterdir()):\n","        n = len(list(sub.iterdir())) if sub.is_dir() else \"-\"\n","        print(f\"   {sub.name}/  ({n} files)\")\n","\n","TRAIN_IMAGE_DIR = SEG_ROOT / \"train\" / \"images\"\n","TRAIN_MASK_DIR  = SEG_ROOT / \"train\" / \"masks\"\n","TEST_IMAGE_DIR  = SEG_ROOT / \"test\"  / \"images\"\n","TEST_MASK_DIR   = SEG_ROOT / \"test\"  / \"masks\"\n","\n","for p in [TRAIN_IMAGE_DIR, TRAIN_MASK_DIR, TEST_IMAGE_DIR, TEST_MASK_DIR]:\n","    print((\"OK   \" if p.exists() else \"MISS \"), p)\n","\n","IMG_EXTS = {\".jpg\", \".jpeg\"}\n","\n","def build_pairs(image_dir, mask_dir):\n","    \"\"\"Pair each image with its mask by filename stem. Images are .jpg, masks .png.\"\"\"\n","    pairs, missing = [], []\n","    for img in sorted(Path(image_dir).iterdir()):\n","        if img.suffix.lower() not in IMG_EXTS:\n","            continue\n","        mask = Path(mask_dir) / (img.stem + \".png\")\n","        (pairs if mask.exists() else missing).append((img, mask) if mask.exists() else img.name)\n","    print(f\"{Path(image_dir).parent.name}: {len(pairs)} pairs, {len(missing)} images without a mask\")\n","    return pairs\n","\n","train_pairs = build_pairs(TRAIN_IMAGE_DIR, TRAIN_MASK_DIR)\n","test_pairs  = build_pairs(TEST_IMAGE_DIR,  TEST_MASK_DIR)"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["test/\n","   images/  (860 files)\n","   masks/  (860 files)\n","train/\n","   images/  (3933 files)\n","   masks/  (3933 files)\n","OK    /kaggle/input/brisc2025/brisc2025/segmentation_task/train/images\n","OK    /kaggle/input/brisc2025/brisc2025/segmentation_task/train/masks\n","OK    /kaggle/input/brisc2025/brisc2025/segmentation_task/test/images\n","OK    /kaggle/input/brisc2025/brisc2025/segmentation_task/test/masks\n","train: 3933 pairs, 0 images without a mask\n","test: 860 pairs, 0 images without a mask\n"]}]},{"cell_type":"code","metadata":{"id":"ebef7954","executionInfo":{"status":"ok","timestamp":1788882298786,"user_tz":-180,"elapsed":917,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}},"colab":{"base_uri":"https://localhost:8080/","height":442},"outputId":"284dcda2-6661-4f2a-dbc3-178877836251"},"source":["def pad_to_square(image, fill_value=0):\n","    \"\"\"Pad a PIL image to square, centred, with the given fill value.\"\"\"\n","    width, height = image.size\n","    max_dim = max(width, height)\n","    padded = Image.new(image.mode, (max_dim, max_dim), fill_value)\n","    padded.paste(image, ((max_dim - width) // 2, (max_dim - height) // 2))\n","    return padded\n","\n","if train_pairs:\n","    img_path, mask_path = train_pairs[0]\n","    original_image = Image.open(img_path).convert('L')\n","    original_mask  = Image.open(mask_path).convert('L')\n","    padded_image = pad_to_square(original_image)\n","    padded_mask  = pad_to_square(original_mask)\n","\n","    print(\"Image:\", img_path.name)\n","    print(\"Mask :\", mask_path.name)\n","    print(f\"Original size: {original_image.size}  ->  padded: {padded_image.size}\")\n","\n","    titles = ['Original Image', 'Original Mask', 'Padded Image', 'Padded Mask']\n","    images = [original_image, original_mask, padded_image, padded_mask]\n","    plt.figure(figsize=(14, 4))\n","    for i, (im, t) in enumerate(zip(images, titles), start=1):\n","        plt.subplot(1, 4, i)\n","        plt.imshow(im, cmap='gray')\n","        plt.title(t)\n","        plt.axis('off')\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    print(\"No pairs found. Check the paths printed by the previous cell.\")"],"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Image: brisc2025_train_00001_gl_ax_t1.jpg\n","Mask : brisc2025_train_00001_gl_ax_t1.png\n","Original size: (512, 512)  ->  padded: (512, 512)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x400 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"388b1ee8"},"source":[" Segmentation Evaluation Metrics\n","\n","As discussed, pixel accuracy is unsuitable for this task due to severe class imbalance. We will use more appropriate metrics like the **Dice Coefficient** (F1-score) and **Intersection over Union (IoU)**, which are standard for segmentation problems and are robust to class imbalance. These metrics quantify the overlap between the predicted mask and the ground truth mask."]},{"cell_type":"code","metadata":{"id":"4370d82a","executionInfo":{"status":"ok","timestamp":1788882298787,"user_tz":-180,"elapsed":12,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}}},"source":["from tensorflow.keras import backend as K\n","\n","def _dice(y_true, y_pred, smooth=1.0):\n","    \"\"\"Dice per image, keeping the batch axis.\"\"\"\n","    axes = [1, 2, 3]\n","    inter = K.sum(y_true * y_pred, axis=axes)\n","    denom = K.sum(y_true, axis=axes) + K.sum(y_pred, axis=axes)\n","    return (2. * inter + smooth) / (denom + smooth)\n","\n","def dice_loss(y_true, y_pred):\n","    \"\"\"Soft Dice loss, for training. Gradients need un-thresholded predictions.\"\"\"\n","    return 1 - K.mean(_dice(y_true, y_pred))\n","\n","def dice_coef(y_true, y_pred):\n","    \"\"\"Thresholded Dice, for reporting. Matches what the deployed system does.\"\"\"\n","    return K.mean(_dice(y_true, K.cast(y_pred > 0.5, 'float32')))\n","\n","def iou_coef(y_true, y_pred, smooth=1.0):\n","    y_pred = K.cast(y_pred > 0.5, 'float32')\n","    axes = [1, 2, 3]\n","    inter = K.sum(y_true * y_pred, axis=axes)\n","    union = K.sum(y_true, axis=axes) + K.sum(y_pred, axis=axes) - inter\n","    return K.mean((inter + smooth) / (union + smooth))"],"execution_count":6,"outputs":[]},{"cell_type":"code","source":["!pip install -q segmentation-models albumentations tf_keras\n","\n","import os\n","os.environ[\"SM_FRAMEWORK\"] = \"tf.keras\"\n","os.environ[\"TF_USE_LEGACY_KERAS\"] = \"1\"\n","\n","import segmentation_models as sm\n","import albumentations as A\n","print(\"segmentation_models:\", sm.__version__)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2qcA7jW4Lci_","executionInfo":{"status":"ok","timestamp":1788882354976,"user_tz":-180,"elapsed":11142,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}},"outputId":"70edd6a1-5387-4fb3-c245-b3875c9f24f5"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[?25l   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m0.0/50.7 kB\u001b[0m \u001b[31m?\u001b[0m eta \u001b[36m-:--:--\u001b[0m\r\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m50.7/50.7 kB\u001b[0m \u001b[31m4.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25hSegmentation Models: using `tf.keras` framework.\n","segmentation_models: 1.0.1\n"]}]},{"cell_type":"code","source":["import random\n","from collections import Counter\n","\n","RANDOM_SEED = 42\n","VAL_FRACTION = 0.15\n","\n","def parse_meta(path):\n","    # brisc2025_train_00001_gl_ax_t1.jpg -> class 'gl', plane 'ax'\n","    parts = path.stem.split(\"_\")\n","    return parts[3], parts[4]\n","\n","# Group by (class, plane) so both are proportionally represented in val\n","groups = {}\n","for img, mask in train_pairs:\n","    groups.setdefault(parse_meta(img), []).append((img, mask))\n","\n","rng = random.Random(RANDOM_SEED)\n","train_split, val_split = [], []\n","for key, items in sorted(groups.items()):\n","    items = sorted(items)          # deterministic before shuffling\n","    rng.shuffle(items)\n","    n_val = round(len(items) * VAL_FRACTION)\n","    val_split += items[:n_val]\n","    train_split += items[n_val:]\n","\n","rng.shuffle(train_split)\n","rng.shuffle(val_split)\n","\n","print(f\"train {len(train_split)} | val {len(val_split)} | test {len(test_pairs)}\")\n","for name, split in [(\"train\", train_split), (\"val\", val_split)]:\n","    print(name, \"class:\", dict(Counter(parse_meta(i)[0] for i, _ in split)))\n","    print(name, \"plane:\", dict(Counter(parse_meta(i)[1] for i, _ in split)))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hxq64vK9Ll2z","executionInfo":{"status":"ok","timestamp":1788882355021,"user_tz":-180,"elapsed":44,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}},"outputId":"bb85ba7e-94e2-4429-f1dc-a37ae08cdcb9"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["train 3345 | val 588 | test 860\n","train class: {'me': 1130, 'pi': 1239, 'gl': 976}\n","train plane: {'sa': 1126, 'ax': 1057, 'co': 1162}\n","val class: {'pi': 218, 'me': 199, 'gl': 171}\n","val plane: {'ax': 186, 'co': 204, 'sa': 198}\n"]}]},{"cell_type":"code","source":["import numpy as np\n","from tensorflow.keras.utils import Sequence\n","\n","IMG_SIZE = 256\n","BACKBONE = \"resnet34\"\n","preprocess_input = sm.get_preprocessing(BACKBONE)\n","\n","train_aug = A.Compose([\n","    A.HorizontalFlip(p=0.5),\n","    A.VerticalFlip(p=0.5),\n","    A.Rotate(limit=15, p=0.5),\n","    A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),\n","    A.ElasticTransform(alpha=1, sigma=50, p=0.3),\n","])\n","\n","def load_pair(img_path, mask_path, size=IMG_SIZE):\n","    img  = pad_to_square(Image.open(img_path).convert(\"RGB\"))\n","    mask = pad_to_square(Image.open(mask_path).convert(\"L\"))\n","    img  = img.resize((size, size), Image.BILINEAR)     # smooth for the scan\n","    mask = mask.resize((size, size), Image.NEAREST)     # keeps the mask binary\n","    return np.array(img), (np.array(mask) > 127).astype(np.float32)\n","\n","class SegSequence(Sequence):\n","    def __init__(self, pairs, batch_size=16, augment=False, shuffle=False):\n","        self.pairs, self.batch_size = list(pairs), batch_size\n","        self.augment, self.shuffle = augment, shuffle\n","        self.on_epoch_end()\n","\n","    def __len__(self):\n","        return int(np.ceil(len(self.pairs) / self.batch_size))\n","\n","    def on_epoch_end(self):\n","        if self.shuffle:\n","            random.Random(RANDOM_SEED).shuffle(self.pairs)\n","\n","    def __getitem__(self, idx):\n","        batch = self.pairs[idx * self.batch_size:(idx + 1) * self.batch_size]\n","        X, Y = [], []\n","        for img_path, mask_path in batch:\n","            img, mask = load_pair(img_path, mask_path)\n","            if self.augment:\n","                out = train_aug(image=img, mask=mask)\n","                img, mask = out[\"image\"], out[\"mask\"]\n","            X.append(img)\n","            Y.append(mask[..., None])\n","        return preprocess_input(np.array(X, dtype=np.float32)), np.array(Y, dtype=np.float32)\n","\n","train_gen = SegSequence(train_split, batch_size=16, augment=True,  shuffle=True)\n","val_gen   = SegSequence(val_split,   batch_size=16, augment=False, shuffle=False)\n","test_gen  = SegSequence(test_pairs,  batch_size=16, augment=False, shuffle=False)\n","\n","xb, yb = train_gen[0]\n","print(\"batch:\", xb.shape, yb.shape, \"| mask values:\", np.unique(yb))\n","print(f\"tumour pixels in batch: {yb.mean() * 100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uBWvp_dqLosE","executionInfo":{"status":"ok","timestamp":1788882363939,"user_tz":-180,"elapsed":418,"user":{"displayName":"Raed Almjally","userId":"06480744608212198207"}},"outputId":"084bd56a-fbce-4d9d-bc7b-f308a30020b9"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["batch: (16, 256, 256, 3) (16, 256, 256, 1) | mask values: [0. 1.]\n","tumour pixels in batch: 1.79%\n"]}]},{"cell_type":"code","source":["from tensorflow.keras.optimizers import Adam\n","\n","model = sm.Unet(\n","    BACKBONE,\n","    encoder_weights=\"imagenet\",\n","    input_shape=(IMG_SIZE, IMG_SIZE, 3),\n","    classes=1,\n","    activation=\"sigmoid\",\n","    encoder_freeze=True,          # phase 1: train the decoder only\n",")\n","\n","total_loss = sm.losses.DiceLoss() + sm.losses.BinaryFocalLoss()\n","\n","model.compile(\n","    optimizer=Adam(1e-3),\n","    loss=total_loss,\n","    metrics=[dice_coef, iou_coef],\n",")\n","print(f\"params: {model.count_params():,}